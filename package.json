{
  "name": "chaos-club",
  "version": "0.1.0",
  "private": true,
  "description": "CHAOS CLUB: Less serious. More chaos.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"server/src/**/*.ts\" \"shared/src/**/*.ts\" \"shared/tests/**/*.ts\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
