# CHAOS CLUB environment variables
# Copy this file to ".env" (copy .env.example .env) and edit the copy.
# NEVER commit the real .env file. NEVER put real production passwords in this example file.

NODE_ENV=development

# --- Realtime server (server/) ---
SERVER_PORT=4000
# The address the website runs on. The server only accepts browser connections from here.
WEB_ORIGIN=http://localhost:3000

# --- PostgreSQL (used by docker-compose.yml and later by Prisma) ---
POSTGRES_USER=chaos
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=chaos_club
DATABASE_URL=postgresql://chaos:local_dev_password_change_me@localhost:5432/chaos_club

# Admin login variables will be added in a later phase.
# The website (web/) reads its own settings from web/.env.local, added when needed.
